# --- Hindsight (required for the hackathon; leave blank to run in offline local mode) ---
# Hindsight Cloud: https://ui.hindsight.vectorize.io  (promo code MEMHACK99 for $50 credits)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
# Or self-hosted: HINDSIGHT_BASE_URL=http://localhost:8888  (no key)
HINDSIGHT_BANK=precedent-oncall

# --- LLM (optional, Groq free tier). Without it the rules engine writes the briefs. ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
PORT=3000
